generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  firebaseId  String   @unique @map("firebase_id")
  email       String?  @map("email")
  displayName String?  @map("display_name")
  photoURL    String?  @map("photo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String?  @map("name")
  email     String?  @map("email")
  message   String?  @map("message")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contacts")
}

model Chat {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  sessionId String?  @map("session_id")
  message   String?  @map("message")
  assistantMessage String? @map("assistant_message")
  assistantModel   String? @map("assistant_model")
  assistantCreatedAt DateTime? @map("assistant_created_at")
  assistantResponse Json? @map("assistant_response")
  state     Json?    @map("state")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("chats")
}
